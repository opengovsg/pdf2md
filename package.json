    "minimist": "^1.2.5",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "chai": "^4.2.0",
    "eslint": "^10.4.0",
    "mocha": "^10.2.0",
    "mock-fs": "^4.10.1",
    "nyc": "^18.0.0",
    "rewire": "^9.0.1"
